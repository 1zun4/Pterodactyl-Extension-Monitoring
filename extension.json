{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "monitoring",
    "name": "Monitoring",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "Resource history, alerts, panel health and Uptime Kuma push monitors.",
    "author": "Izuna Seikatsu",
    "provider": "Monitoring\\MonitoringProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mon",
        "screens": [
            {
                "id": "server",
                "area": "server",
                "path": "monitoring",
                "nav": {
                    "label": "Monitoring",
                    "icon": "activity",
                    "order": 30
                },
                "permission": [
                    "ext.monitoring.read"
                ]
            },
            {
                "id": "alerts",
                "area": "account",
                "path": "alerts",
                "nav": {
                    "label": "Alerts",
                    "icon": "bell"
                }
            },
            {
                "id": "admin",
                "area": "admin",
                "path": "monitoring",
                "nav": {
                    "label": "Monitoring",
                    "icon": "activity"
                }
            },
            {
                "id": "server-tab",
                "area": "admin",
                "parent": "admin.server",
                "path": "monitoring",
                "nav": {
                    "label": "Monitoring",
                    "order": 20
                }
            }
        ]
    },
    "icon": "activity"
}
